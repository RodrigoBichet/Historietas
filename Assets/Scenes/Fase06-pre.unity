  profile: {fileID: 21300000, guid: 68cffdc306b1c7f4f9c4886947852fd2, type: 3}
  speechText:
  - "De repente, apareceu o Lobo! Onde vai, Chapeuzinho? -perguntou ele, com um sorriso
    esquisito. Vou visitar minha vov\xF3. Ela mora depois da colina! O Lobo correu
    rapidinho e chegou primeiro na casa da vov\xF3. Mas a vov\xF3 era esperta e se
    escondeu no arm\xE1rio!"
  actorName: ' '
  activateDialogueButton: {fileID: 955377831}
